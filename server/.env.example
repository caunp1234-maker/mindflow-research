# server/.env 로 복사해서 값을 채운다. .env는 git에 커밋하지 않는다.

# PostgreSQL 접속 문자열
DATABASE_URL=postgres://mindflow:mindflow@localhost:5432/mindflow_research

# JWT 서명 키 (openssl rand -hex 32 등으로 생성)
JWT_SECRET=change-me

# 피험자 PII 컬럼 암호화 키 — 반드시 32바이트를 base64로 인코딩한 값
# 생성 예: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=change-me-32-byte-base64-key

PORT=3000
